# ===== Loom 环境变量模板 =====
# 复制本文件为 .env 并填入真实值(本机开发用);部署到 Railway 时,这些值在
# Railway 的 Variables 面板里配置,不要提交到仓库。

# Telegram Bot Token —— 在 Telegram 里找 @BotFather,发 /newbot 创建后获得
TELEGRAM_BOT_TOKEN=

# Anthropic API Key —— 在 https://console.anthropic.com 申请
ANTHROPIC_API_KEY=

# 可选:Anthropic API 中转站 base_url。官方直连就留空;用中转站就填中转站给的地址。
# ANTHROPIC_BASE_URL=https://你的中转站地址

# 数据库连接串。Railway 附加 Postgres 服务后会自动注入 DATABASE_URL,无需手填。
# 本机开发默认用 SQLite,可留空。
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# 可选:webhook 公网地址,Railway 分配后形如 https://xxx.up.railway.app
# 配置后,服务启动时会自动把 Telegram webhook 指向自己。
# WEBHOOK_URL=

# 可选:Telegram webhook 鉴权 secret(用于校验请求确实来自 Telegram,推荐)
# WEBHOOK_SECRET=

# 可选:保护 /internal/cron 的 secret,只有带对 secret 的请求才会触发定时唤醒
# CRON_SECRET=

# 可选:时区(影响「下周一」这类时间的解析),默认 Asia/Shanghai
# LOOM_TZ=Asia/Shanghai
